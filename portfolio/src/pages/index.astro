---
import "../styles/global.css";

const projects = [
  {
    title: "She Codes Australia",
    year: "2025-Present",
    description:
      "-",
    link: "#",
  },
  {
    title: "Day of AI Australia",
    year: "2025-Present",
    description:
      "-",
    link: "#",
  },
];
---

<html lang="en">
  <head>
    <title>Adelia Widyasari · Portfolio</title>
    <meta
      name="description"
      content="Tech + graphic design portfolio by Adelia Widyasari."
    />
  </head>
	<body class="page">
	<div class="shell">
		<!-- Folder side nav -->
		<nav class="left-tabs">
		<a class="left-tab left-tab--active" href="#hero">Home</a>
		<a class="left-tab" href="#projects">Work</a>
		<a class="left-tab" href="#about">About</a>
		<a class="left-tab" href="#contact">Contact</a>
		</nav>

		<!-- Page stack: background shape + main page -->
		<div class="page-stack">
		<div class="page-backdrop"></div>

		<div class="main-page">
			<main class="layout">
			<!-- Hero board -->
			<section class="board board-hero" id="hero">
				<header class="board-header">
				<div class="board-title-group">
					<h1 class="brand-name">Adelia Widyasari</h1>
				</div>
				</header>

				<p class="brand-intro">
				She Codes Australia | Day of AI Australia | Computer Science Student and Graphic Designer
				</p>

				<div class="photo-widget">
					<img
						src="/adelia_pfp.jpg"
						alt="Adelia Widyasari"
						class="photo-widget__img"
					/>
				</div>
			</section>

			<!-- Featured projects board -->
			<section class="board board-projects" id="projects">
				<header class="board-section-header">
				<h2 class="section-title">Work</h2>
				<div class="section-filters">
					<span class="tag-pill">Coding</span>
					<span class="tag-pill">Web Design</span>
					<span class="tag-pill">Graphic Design</span>
					<span class="tag-pill">Photography</span>
				</div>
				</header>

				<div class="projects-grid">
				{projects.map((project) => (
					<article class="project-card project-card--featured">
					<header class="project-header">
						<div class="project-title-group">
						<h3 class="project-title">{project.title}</h3>
						<span class="project-year">{project.year}</span>
						</div>
					</header>

					<div class="project-thumbnail">
						<div class="thumbnail-placeholder">
						<span>Project preview</span>
						</div>
					</div>

					<p class="project-description">{project.description}</p>

					<a href={project.link} class="project-link">
						View project
					</a>
					</article>
				))}
				</div>
			</section>

			<!-- About panel -->
			<aside class="board board-about" id="about">
				<h2 class="section-title">About</h2>
				<p class="about-text">
				miao
				</p>
				<span><a href="#contact" class="primary-button">Say hello</a></span>
			</aside>
			</main>

			<!-- Footer inside main page -->
			<footer class="footer" id="contact">
			<div class="footer-inner">
				<span>{new Date().getFullYear()} Adelia Widyasari</span>
				<nav class="footer-links">
				<a href="https://www.behance.net/adelia_widyasari" target="_blank"
					>Behance</a
				>
				<a href="https://github.com/AWZO" target="_blank">GitHub</a>
				</nav>
			</div>
			</footer>
		</div>
		</div>
	</div>
	</body>
</html>